<?xml version='1.0' encoding='utf-8'?>
<ui version="4.0">
  <class>CaserneConnectee</class>
  <widget class="QMainWindow" name="CaserneConnectee">
    <property name="geometry">
      <rect>
        <x>0</x>
        <y>0</y>
        <width>1366</width>
        <height>768</height>
      </rect>
    </property>
    <property name="windowTitle">
      <string>Caserne Connectée — Module Employé</string>
    </property>
    <property name="windowIcon">
      <iconset resource="ressources.qrc"><normaloff>:/images/logo.png</normaloff>:/images/logo.png</iconset>
    </property>
    <property name="styleSheet">
      <string>/* Charte graphique : orange #E4491F, vert #1E9E63, ambre #E08E0B, rouge #D93636, bleu #2F6FE0, encre #16202A */
QWidget { font-family: "Segoe UI"; font-size: 10pt; color: #16202A; }
QMainWindow, QStackedWidget { background: #EDF1F5; }
QLabel { background: transparent; }

/* ---------- Connexion et mot de passe oublié (fond sombre) ---------- */
#PLogin, #PMotDePasseOublie { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0B1016, stop:0.6 #151B24, stop:1 #3A1C12); }
QLabel[variante="surtitre"] { color: #FF8A5B; font-size: 9pt; font-weight: bold; }
QLabel[variante="grandTitre"] { color: white; font-size: 26pt; font-weight: bold; }
QLabel[variante="atoutTitre"] { color: #E8EDF2; font-size: 11pt; font-weight: bold; }
QLabel[variante="texteClair"] { color: #93A4B2; font-size: 10pt; }
QFrame[variante="carteConnexion"] { background: rgba(22, 30, 39, 235); border: 1px solid #2A3643; border-radius: 20px; }
QLabel[variante="titreConnexion"] { color: white; font-size: 17pt; font-weight: bold; }
QLabel[variante="champ"] { color: #8B9CAB; font-size: 8pt; font-weight: bold; margin-top: 6px; }
QLabel[variante="pied"] { color: #5E6E7C; font-size: 8pt; margin-top: 6px; }
QFrame[variante="carteConnexion"] QLineEdit { background: rgba(8, 12, 17, 160); color: white; border: 1.5px solid #2A3643;
    border-radius: 11px; padding: 10px 12px; }
QFrame[variante="carteConnexion"] QLineEdit:focus { border-color: #E4491F; }
QPushButton[variante="connexion"] { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FF8052, stop:1 #E4491F);
    color: white; border: none; border-radius: 11px; padding: 12px; font-weight: bold; font-size: 11pt; }
QPushButton[variante="connexion"]:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FF9166, stop:1 #F0552A); }
QPushButton[variante="lien"] { background: transparent; border: none; color: #FF8A5B; font-weight: bold; padding: 2px; }
QPushButton[variante="lien"]:hover { color: #FFB08F; }

/* ---------- En-tête des pages ---------- */
QFrame[variante="entete"] { background: white; border: none; border-bottom: 1px solid #E1E6EC; }
QLabel[variante="titre"] { font-size: 16pt; font-weight: bold; }
QLabel[variante="sousTitre"] { color: #7A8896; }
QFrame[variante="pastilleUtilisateur"] { background: #F4F6F9; border: 1px solid #E1E6EC; border-radius: 17px; }
QLabel[variante="texteUtilisateur"] { color: #45505C; font-weight: bold; font-size: 9pt; }

/* ---------- Menu principal ---------- */
QFrame[variante="bienvenue"] { border-radius: 16px; border: none;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #16202A, stop:0.7 #2B2420, stop:1 #E4491F); }
QLabel[variante="bienvenueTitre"] { color: white; font-size: 18pt; font-weight: bold; }
QLabel[variante="bienvenueTexte"] { color: #C9D3DC; font-size: 10pt; }
QPushButton[variante="tuile"] { background: white; border: 1px solid #E1E6EC; border-bottom: 3px solid #DCE2EA;
    border-radius: 16px; padding: 18px 22px; font-size: 11.5pt; font-weight: bold; text-align: left; min-height: 96px; }
QPushButton[variante="tuile"]:hover { border-color: #F5B49B; border-bottom-color: #E4491F; background: #FFF8F5; }

/* ---------- Cartes "chiffre clé" ---------- */
QFrame[variante="kpi"] { background: white; border: 1px solid #E1E6EC; border-bottom: 2px solid #DCE2EA; border-radius: 14px; }
QLabel[variante="kpiTitre"] { color: #5B6B7A; font-weight: bold; }
QLabel[variante="kpiValeur"] { font-size: 20pt; font-weight: bold; }
QLabel[variante="kpiDetail"] { color: #8B99A6; font-size: 8.5pt; }

/* ---------- Panneaux ---------- */
QFrame[variante="panneau"] { background: white; border: 1px solid #E1E6EC; border-bottom: 2px solid #DCE2EA; border-radius: 14px; }
QLabel[variante="titrePanneau"] { font-size: 11.5pt; font-weight: bold; }
QLabel[variante="sousTitrePanneau"] { color: #8B99A6; font-size: 9pt; }
QLabel[variante="libelle"] { color: #5B6B7A; }
QLabel[variante="note"] { color: #5B6B7A; }
QLabel[variante="petitTitre"] { color: #8B99A6; font-size: 8.5pt; font-weight: bold; }
QLabel[variante="valeur"] { font-weight: bold; min-width: 34px; }
QLabel[variante="grandChiffre"] { color: #E4491F; font-size: 15pt; font-weight: bold; }
QLabel[variante="conseil"] { color: #1E7A4F; background: #E6F5EE; border: 1px dashed #1E9E63; border-radius: 10px; padding: 10px; font-weight: bold; }
QLabel[variante="conseilRouge"] { color: #B42A2A; background: #FCE9E9; border: 1px dashed #D93636; border-radius: 10px; padding: 10px; font-weight: bold; }
QFrame[variante="resultat"] { background: #FFF3EE; border: 1px dashed #E4491F; border-radius: 12px; }

/* ---------- Boutons ---------- */
QPushButton { background: white; border: 1.5px solid #DCE1E8; border-radius: 9px; padding: 7px 14px; font-weight: bold; color: #2B3742; }
QPushButton:hover { background: #F3F5F8; border-color: #C5CDD6; }
QPushButton:pressed { background: #E9EDF2; }
QPushButton[variante="principal"] { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FF7A4D, stop:1 #E4491F); color: white; border: none; }
QPushButton[variante="principal"]:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FF8A5F, stop:1 #F0552A); }
QPushButton[variante="danger"] { color: #D93636; border-color: #F3C4C4; }
QPushButton[variante="danger"]:hover { background: #FCEDED; }

/* ---------- Champs de saisie ---------- */
QLineEdit, QComboBox, QDateEdit, QSpinBox { background: #FAFBFC; border: 1.5px solid #DCE1E8; border-radius: 9px; padding: 6px 9px; }
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus { border-color: #E4491F; background: white; }
QComboBox::drop-down, QDateEdit::drop-down { border: none; width: 24px; }

/* ---------- Tableaux ---------- */
QTableWidget { background: white; border: none; alternate-background-color: #F8FAFC;
    selection-background-color: #FDE9E1; selection-color: #16202A; }
QTableWidget::item { padding: 0 8px; border-bottom: 1px solid #EFF2F6; }
QHeaderView::section { background: #F4F6F9; color: #7A8896; font-size: 8.5pt; font-weight: bold; border: none;
    border-bottom: 1px solid #E1E6EC; padding: 8px; }

/* ---------- Jauges (statistiques) ---------- */
QProgressBar { background: #EDF0F4; border: none; border-radius: 4px; }
QProgressBar::chunk { border-radius: 4px; background: #E4491F; }
QProgressBar[variante="vert"]::chunk { background: #1E9E63; }
QProgressBar[variante="ambre"]::chunk { background: #E08E0B; }
QProgressBar[variante="rouge"]::chunk { background: #D93636; }
QProgressBar[variante="bleu"]::chunk { background: #2F6FE0; }
QProgressBar[variante="gris"]::chunk { background: #9AA5B1; }

/* ---------- Barres de défilement ---------- */
QScrollBar:horizontal { background: transparent; height: 10px; border: none; }
QScrollBar:vertical { background: transparent; width: 10px; border: none; }
QScrollBar::handle:horizontal { background: #CFD6DE; border-radius: 5px; min-width: 30px; }
QScrollBar::handle:vertical { background: #CFD6DE; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ---------- Flèche des listes déroulantes ---------- */
QComboBox::down-arrow, QDateEdit::down-arrow { image: url(:/images/icones/chevron-down_gris.png); width: 12px; height: 12px; }

/* ---------- Barre latérale (menu de l'application) ---------- */
QFrame[variante="barreLaterale"] { background: #F7F9FB; border: none; border-right: 1px solid #E1E6EC; }
QLabel[variante="marque"] { font-size: 12pt; font-weight: bold; }
QLabel[variante="sousMarque"] { color: #6B7A88; font-size: 7.5pt; font-weight: bold; }
QLabel[variante="sectionNav"] { color: #8B99A6; font-size: 8pt; font-weight: bold; margin-top: 12px; margin-left: 8px; }
QPushButton[variante="nav"] { background: transparent; border: none; border-radius: 10px; text-align: left;
    padding: 10px 12px; font-size: 10.5pt; font-weight: normal; color: #2B3742; }
QPushButton[variante="nav"]:hover { background: #EEF1F5; }
QPushButton[variante="nav"]:checked { background: #FDE9E1; color: #E4491F; font-weight: bold; border-left: 3px solid #E4491F; }
QFrame[variante="carteGarde"] { background: white; border: 1px solid #E1E6EC; border-radius: 12px; }
QLabel[variante="gardeTitre"] { font-weight: bold; font-size: 9.5pt; }
QLabel[variante="gardeTexte"] { color: #8B99A6; font-size: 8.5pt; }
QLabel[variante="avatar"] { background: #2F6FE0; color: white; font-weight: bold; border-radius: 19px;
    min-width: 38px; max-width: 38px; min-height: 38px; max-height: 38px; }
QLabel[variante="utilisateurNom"] { font-weight: bold; }
QLabel[variante="utilisateurRole"] { color: #8B99A6; font-size: 9pt; }
QPushButton[variante="deconnexion"] { color: #D93636; border-color: #F3C4C4; background: white; }
QPushButton[variante="deconnexion"]:hover { background: #FCEDED; }

/* ---------- En-tête : pastille "En ligne" ---------- */
QFrame[variante="enLigne"] { background: #E6F5EE; border-radius: 15px; }
QLabel[variante="enLigneTexte"] { color: #1E9E63; font-weight: bold; }

/* ---------- Tableau de bord : bandeau d'alerte ---------- */
QFrame[variante="alerte"] { background: #FDEDED; border: 1.5px solid #F2B8B8; border-radius: 14px; }
QLabel[variante="alerteTitre"] { color: #C62828; font-weight: bold; font-size: 10.5pt; }
QLabel[variante="alerteTexte"] { color: #6B3A3A; }
QPushButton[variante="alerte"] { color: #D93636; border-color: #F2B8B8; background: white; }

/* ---------- Zones qui défilent (petits écrans) ---------- */
QScrollArea { background: transparent; border: none; }
QWidget[variante="contenuDefilant"] { background: #EDF1F5; }


/* ---------- Listes déroulantes : choix bien visibles (fond clair, sélection orange) ---------- */
QComboBox QAbstractItemView { background: white; color: #16202A; border: 1px solid #DCE1E8; border-radius: 8px;
    padding: 4px; outline: none; selection-background-color: #FDE9E1; selection-color: #E4491F; }
QComboBox QAbstractItemView::item { min-height: 28px; padding: 0 8px; }

/* ---------- Calendrier (date d'entrée, planning) aux couleurs de la charte ---------- */
QCalendarWidget QWidget#qt_calendar_navigationbar { background: #E4491F; min-height: 36px; }
QCalendarWidget QToolButton { color: white; background: transparent; border: none; border-radius: 6px;
    font-weight: bold; padding: 4px 8px; }
QCalendarWidget QToolButton:hover { background: #F06A40; }
QCalendarWidget QToolButton#qt_calendar_prevmonth { qproperty-icon: url(:/images/icones/chevron-left_blanc.png); }
QCalendarWidget QToolButton#qt_calendar_nextmonth { qproperty-icon: url(:/images/icones/chevron-right_blanc.png); }
QCalendarWidget QToolButton::menu-indicator { image: none; width: 0; }
QCalendarWidget QMenu { background: white; color: #16202A; border: 1px solid #DCE1E8; }
QCalendarWidget QMenu::item:selected { background: #FDE9E1; color: #E4491F; }
QCalendarWidget QSpinBox { background: white; color: #16202A; border: none; border-radius: 6px; padding: 2px 6px;
    selection-background-color: #FDE9E1; selection-color: #16202A; }
QCalendarWidget QAbstractItemView { background: white; color: #16202A; outline: none;
    selection-background-color: #E4491F; selection-color: white; }
QCalendarWidget QAbstractItemView:disabled { color: #B8C1CB; }

/* ---------- En-tête : mode sombre / langue / notifications, date et heure ---------- */
QPushButton[variante="iconeEntete"] { background: #F4F6F9; border: 1px solid #E1E6EC; border-radius: 10px; padding: 0;
    min-width: 38px; max-width: 38px; min-height: 38px; max-height: 38px; font-size: 13pt; font-weight: bold; color: #45505C; }
QPushButton[variante="iconeEntete"]:hover { background: #FDE9E1; border-color: #F5B49B; }
QLabel[variante="heure"] { font-size: 14pt; font-weight: bold; }
QLabel[variante="date"] { color: #7A8896; font-size: 8.5pt; }

/* ---------- Formulaire employé : photo, mot de passe, carte « temps de service » ---------- */
QPushButton[variante="photo"] { background: #FFF3EE; border: 2px dashed #E4491F; border-radius: 32px; padding: 0;
    min-width: 64px; max-width: 64px; min-height: 64px; max-height: 64px; }
QPushButton[variante="photo"]:hover { background: #FDE9E1; border-style: solid; }
QFrame[variante="motDePasse"] { background: #FFF8F5; border: 1px dashed #F5B49B; border-radius: 10px; }
QLabel[variante="forceMotDePasse"] { color: #7A8896; font-size: 8.5pt; font-weight: bold; min-width: 118px; }
#PGestionEmploye QLineEdit:disabled, #PGestionEmploye QComboBox:disabled, #PGestionEmploye QDateEdit:disabled,
#PGestionEmploye QSpinBox:disabled { background: #F3F5F8; color: #8B99A6; border-color: #E1E6EC; }
#PGestionEmploye QPushButton:disabled { color: #B8C1CB; }
QLabel[variante="forceMotDePasse"][niveau="faible"] { color: #D93636; }
QLabel[variante="forceMotDePasse"][niveau="moyen"] { color: #E08E0B; }
QLabel[variante="forceMotDePasse"][niveau="eleve"] { color: #1E9E63; }
QLabel[variante="correspondance"] { font-size: 8.5pt; font-weight: bold; color: #7A8896; }
QLabel[variante="correspondance"][etat="ok"] { color: #1E9E63; }
QLabel[variante="correspondance"][etat="ko"] { color: #D93636; }
QFrame[variante="accesRefuse"] { background: #FCE9E9; border: 1px solid #F3C4C4; border-radius: 12px; }
QLabel[variante="accesRefuseTexte"] { color: #B42A2A; font-weight: bold; }
QLabel[variante="lectureSeule"] { color: #2F6FE0; background: #E3ECFB; border-radius: 10px; padding: 4px 10px; font-weight: bold; font-size: 8.5pt; }
QFrame[variante="carteVerte"] { background: #F3FBF7; border: 1.5px dashed #1E9E63; border-radius: 12px; }
QLabel[variante="carteVerteSurtitre"] { color: #1E7A4F; font-size: 8pt; font-weight: bold; }
QLabel[variante="carteVerteTitre"] { font-size: 14pt; font-weight: bold; }
QLabel[variante="carteVerteTexte"] { color: #5B6B7A; font-size: 8.5pt; }

/* ---------- Statistiques : anneau de disponibilité ---------- */
QFrame#anneauStatutEmploye { border-radius: 75px; min-width: 150px; max-width: 150px; min-height: 150px; max-height: 150px;
    background: qconicalgradient(cx:0.5, cy:0.5, angle:90,
        stop:0 #1E9E63, stop:0.4999 #1E9E63, stop:0.5 #E08E0B, stop:0.7726 #E08E0B,
        stop:0.7727 #9AA5B1, stop:0.9090 #9AA5B1, stop:0.9091 #2F6FE0, stop:1 #2F6FE0); }
QLabel[variante="anneauCentre"] { background: white; border-radius: 48px; font-size: 15pt; font-weight: bold;
    min-width: 96px; max-width: 96px; min-height: 96px; max-height: 96px; }
QLabel[variante="legende"] { color: #45505C; }
QLabel[variante="pointVert"] { color: #1E9E63; font-size: 13pt; }
QLabel[variante="pointAmbre"] { color: #E08E0B; font-size: 13pt; }
QLabel[variante="pointGris"] { color: #9AA5B1; font-size: 13pt; }
QLabel[variante="pointBleu"] { color: #2F6FE0; font-size: 13pt; }

/* ---------- Effets de survol ---------- */
QFrame[variante="kpi"]:hover { border-color: #F5B49B; border-bottom-color: #E4491F; }
QFrame[variante="panneau"]:hover { border-color: #EBD8CF; }
QTableWidget::item:hover { background: #FFF5F0; }

/* ---------- Notification (toast) ---------- */
QFrame[variante="toast"] { background: #111922; border: 1px solid #2A3643; border-radius: 14px; }
QLabel[variante="toastTitre"] { color: white; font-weight: bold; font-size: 10.5pt; }
QLabel[variante="toastTexte"] { color: #C9D3DC; font-size: 9pt; }

/* ---------- Planning des gardes ---------- */
QTableWidget[variante="planning"] { gridline-color: #EFF2F6; }
QTableWidget[variante="planning"]::item { padding: 0; border-right: 1px solid #EFF2F6; }
QLabel[variante="texteAlerte"] { color: #D93636; font-weight: bold; font-size: 9pt; }
QLabel[variante="texteSucces"] { color: #1E9E63; font-weight: bold; font-size: 9pt; }
QLabel[variante="legendePlanning"] { color: #5B6B7A; font-size: 9pt; }

/* =====================================================================
   THÈME « CASERNE » : barre latérale sombre couleur nuit de garde,
   accents feu (orange / ambre / rouge), animations ajoutées dans le code
   ===================================================================== */
QFrame[variante="barreLaterale"] { border: none; border-right: 1px solid #0B0F14;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #171E27, stop:0.7 #121820, stop:1 #1D1512); }
QFrame[variante="barreLaterale"] QLabel[variante="marque"] { color: #F4F6F8; }
QFrame[variante="barreLaterale"] QLabel[variante="sousMarque"] { color: #FF8A5B; }
QFrame[variante="barreLaterale"] QLabel[variante="sectionNav"] { color: #5E6E7C; }
QPushButton[variante="nav"] { color: #C9D3DC; border-left: 3px solid transparent; }
QPushButton[variante="nav"]:hover { background: #1E2731; color: #F4F6F8; }
QPushButton[variante="nav"]:checked { color: #FFB08F; font-weight: bold; border-left: 3px solid #FF6A3D;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3A2018, stop:1 #171E27); }
QFrame[variante="barreLaterale"] QFrame[variante="carteGarde"] { background: #1C2530; border: 1px solid #263240; }
QFrame[variante="barreLaterale"] QLabel[variante="gardeTitre"] { color: #F4F6F8; }
QFrame[variante="barreLaterale"] QLabel[variante="gardeTexte"] { color: #8B9CAB; }
QFrame[variante="barreLaterale"] QLabel[variante="utilisateurNom"] { color: #F4F6F8; }
QFrame[variante="barreLaterale"] QLabel[variante="utilisateurRole"] { color: #8B9CAB; }
QFrame[variante="barreLaterale"] QLabel[variante="avatar"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FF7A4D, stop:1 #C7341A); }
QFrame[variante="barreLaterale"] QPushButton[variante="deconnexion"] { background: transparent; color: #FF8A80; border-color: #4A2A2A; }
QFrame[variante="barreLaterale"] QPushButton[variante="deconnexion"]:hover { background: #3A1C1C; }
QFrame[variante="barreLaterale"] QProgressBar { background: #263240; }

/* en-têtes de page : liseré orange sous le titre (animé dans le code) */
QFrame[variante="entete"] { border-bottom: 1px solid #F1D9CF; }

/* cartes et panneaux : coin chaleureux au survol, boutons principaux plus vifs */
QFrame[variante="panneau"]:hover { border-color: #F2C9B8; }
QPushButton[variante="principal"]:pressed { background: #C7341A; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #F5B49B; }
QHeaderView::section { border-bottom: 2px solid #F1D9CF; }

/* ---------- En-têtes de page : bandeau sombre « centre de commandement » ---------- */
QFrame[variante="entete"] { border: none;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #141A22, stop:0.6 #19202A, stop:1 #2B1912); }
QFrame[variante="entete"] QLabel[variante="titre"] { color: #F4F6F8; }
QFrame[variante="entete"] QLabel[variante="sousTitre"] { color: #93A4B2; }
QFrame[variante="entete"] QLabel[variante="heure"] { color: #F4F6F8; }
QFrame[variante="entete"] QLabel[variante="date"] { color: #93A4B2; }
QFrame[variante="entete"] QPushButton { background: #222B36; color: #E6EBF0; border: 1px solid #2E3946; }
QFrame[variante="entete"] QPushButton:hover { background: #3A2219; border-color: #7A3E28; }
QFrame[variante="entete"] QPushButton[variante="iconeEntete"] { background: #222B36; border: 1px solid #2E3946; color: #E6EBF0; }
QFrame[variante="entete"] QPushButton[variante="iconeEntete"]:hover { background: #3A2219; border-color: #B4532E; }
QFrame[variante="entete"] QPushButton[variante="principal"] { border: none; color: white;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FF7A4D, stop:1 #E4491F); }
QFrame[variante="entete"] QPushButton[variante="principal"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FF8A5F, stop:1 #F0552A); }
QFrame[variante="entete"] QFrame[variante="enLigne"] { background: #143026; border: 1px solid #1F4A39; }
QFrame[variante="entete"] QLabel[variante="enLigneTexte"] { color: #5FD39B; }

/* ---------- Fond des pages : trame de points discrète (plan de commandement) ---------- */
QWidget[variante="contenuDefilant"] { background-color: #EDF1F5; background-image: url(:/images/motif_points.png); }

/* ---------- Cartes de chiffres clés : dégradé chaud et liseré de feu ---------- */
QFrame[variante="kpi"] { border: 1px solid #E8E1DC; border-top: 3px solid #E4491F; border-radius: 14px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FEFEFE, stop:1 #FFF8F4); }
QFrame[variante="kpi"]:hover { border-color: #F5B49B; border-top: 3px solid #FF6A3D; }
QLabel[variante="kpiValeur"] { color: #16202A; }

/* ---------- Panneaux : titres plus affirmés ---------- */
QLabel[variante="titrePanneau"] { font-size: 12pt; }
QFrame[variante="panneau"] { border-radius: 16px; }


/* ---------- Choix Plan / Carte réelle ---------- */
QPushButton[variante="choixCarte"] { padding: 4px 12px; border-radius: 8px; font-size: 9pt; }
QPushButton[variante="choixCarte"]:checked { background: #FDE9E1; color: #E4491F; border-color: #F5B49B; }


/* ---------- Connexion : messages, mot de passe oublié ---------- */
QLabel[variante="erreurConnexion"] { color: #FF8A80; font-size: 9pt; font-weight: bold; }
QLabel[variante="erreurConnexion"][etat="info"] { color: #5FD39B; }
QLabel[variante="minuteur"] { color: #FFB08F; font-size: 8.5pt; font-weight: bold; }
QLabel[variante="minuteur"][etat="expire"] { color: #FF8A80; }
QStackedWidget#pileEtapesOublie, QWidget#etapeEmailOublie, QWidget#etapeCodeOublie { background: transparent; }
QFrame[variante="carteConnexion"] QLineEdit[variante="code"] { font-size: 20pt; font-weight: bold; padding: 8px 12px; color: #FFB08F; }


/* ---------- Fiche : droits d'accès aux modules ---------- */
QFrame[variante="acces"] { background: #FFF8F5; border: 1px dashed #F5B49B; border-radius: 10px; }
QLabel[variante="noteAcces"] { color: #8B99A6; font-size: 8pt; }
QLabel[variante="moduleAcces"] { color: #45505C; font-size: 9pt; font-weight: bold; }
QPushButton[variante="principal"]:disabled { background: #E9EDF2; color: #B8C1CB; }

#PModule QPushButton:disabled { color: #B8C1CB; }
QLabel[variante="nonDeveloppe"] { background: #F7F9FB; border: 2px dashed #DCE1E8; border-radius: 14px; color: #45505C; padding: 24px; }
/* ---------- Boutons désactivés (droits insuffisants) ---------- */
QPushButton[variante="principal"]:disabled { background: #E9EDF2; color: #B8C1CB; }
QPushButton[variante="danger"]:disabled { border-color: #E1E6EC; }

/* ---------- Confirmation de suppression ---------- */
QMessageBox[variante="confirmation"] { background: white; }
QMessageBox[variante="confirmation"] QLabel { color: #16202A; font-size: 10.5pt; }
QPushButton[variante="dangerPlein"] { background: #D93636; color: white; border: none; min-width: 90px; }
QPushButton[variante="dangerPlein"]:hover { background: #C62828; }

/* ---------- Tableau de bord : choix de la carte (Plan / Carte réelle) ---------- */
QPushButton[variante="segment"] { background: #F4F6F9; border: 1px solid #E1E6EC; border-radius: 9px; padding: 4px 12px;
    color: #5B6B7A; font-size: 8.5pt; font-weight: bold; }
QPushButton[variante="segment"]:hover { border-color: #F5B49B; color: #C7341A; }
QPushButton[variante="segment"]:checked { background: #FDE9E1; border-color: #E4491F; color: #C7341A; }
</string>
